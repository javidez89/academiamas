{
  "name": "qavance",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:syntax": "node tools/check-js.mjs",
    "check:version": "node tools/check-version.mjs",
    "check": "npm run check:syntax && npm run check:version",
    "test:migration-baseline": "node tools/migration-baseline-audit.mjs",
    "test:verified-time": "node tools/verified-study-sessions-unit.mjs",
    "test:verified-assessment": "node tools/generate-assessment-registry.mjs --check supabase/migrations/20260827180258_assessment_registry_v1.sql && node tools/verified-assessment-unit.mjs",
    "test:authoritative-progress": "node tools/generate-learning-requirements.mjs --check supabase/migrations/20260827225551_authoritative_learning_aggregates.sql && node tools/authoritative-progress-unit.mjs",
    "test:legacy-transition": "node tools/legacy-progress-smoke.mjs",
    "generate:seo": "node tools/generate-seo.mjs",
    "generate:brand": "node tools/generate-brand-assets.mjs",
    "generate:audio-manifest": "node tools/generate-audio-manifest.mjs",
    "translate:syllabus": "node tools/translate-syllabus-content.mjs",
    "test:unit": "node tools/storage-unit.mjs && node tools/selection-unit.mjs && node tools/audio-manifest-unit.mjs && npm run test:verified-time && npm run test:verified-assessment && npm run test:authoritative-progress",
    "test:content": "node tools/course-content-audit.mjs && node tools/simulator-realism-audit.mjs && node tools/question-bank-sources-audit.mjs",
    "test:integration": "node tools/catalog-smoke.mjs",
    "test:seo": "node tools/seo-smoke.mjs",
    "test:pwa": "node tools/pwa-smoke.mjs",
    "test:auth": "node tools/auth-smoke.mjs",
    "test:cloud": "node tools/cloud-account-smoke.mjs",
    "test:audio": "node tools/audio-fallback-smoke.mjs",
    "test:admin": "node tools/admin-smoke.mjs",
    "test:certificates": "node tools/certificate-smoke.mjs",
    "test:home-advantages": "node tools/home-advantages-smoke.mjs",
    "test:certificate-pdf": "npx --yes deno@2.9.6 run --frozen --node-modules-dir=auto --allow-read --allow-write tools/certificate-pdf-preview.ts",
    "test:e2e": "node tools/smoke.mjs",
    "test:visual": "node tools/chapter-visual-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  }
}
